{
  "name": "dsh-dayu-memory-star",
  "version": "1.1.1",
  "description": "把智能体的长期记忆变成一片可以漫游的星图（DSH 插件）。内置艾宾浩斯遗忘曲线 + 类型权重 + 手动权重的记忆模型；新增记忆时自动按内容归类、自动算关键词、自动连到最相关的记忆。纯本地 JSON 存储、零依赖、零出站请求；同时提供可被 QQBridge / AstrBot 直接 require 的记忆核心。",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "memory",
    "ebbinghaus",
    "forgetting-curve",
    "star-map",
    "agent",
    "chatbot",
    "qqbot",
    "napcat",
    "astrbot"
  ],
  "license": "MIT",
  "author": "大肥鱼",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./memory-core": "./lib/memory-core.js",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib/index.js",
    "lib/memory-core.js",
    "lib/client.js",
    "locale/zh.json",
    "locale/en.json",
    "examples/qqbridge-integration.js",
    "examples/astrbot_integration.py",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "README.en.md",
    "LICENSE",
    "test/smoke.js",
    "记忆模型说明.md"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.1.5"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node test/smoke.js"
  },
  "icon": "./icon.svg"
}
